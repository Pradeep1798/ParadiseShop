{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "src",
    "paths": {
  "public/*": ["public/*"],
  "views/*": ["views/*"],
  "services/*": ["services/*"],
  "utils/*": ["utils/*"],
}
  },
  "extends": "@react-native/typescript-config/tsconfig.json"
}